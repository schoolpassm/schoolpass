rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // 공통 헬퍼 함수
    // ------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return isSignedIn() ? myUser().role : null;
    }

    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }

    function isManager() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'manager');
    }

    // count() 등 집계쿼리는 get()으로 다른 문서를 읽는 규칙과 호환되지 않는다.
    // 이 함수는 Firestore 문서 조회(get()) 없이 로그인 토큰의 커스텀 클레임만으로 판단해
    // 집계쿼리에서도 사용할 수 있다. /api/users/sync-claims 로 클레임을 최신화해둬야 정확하다.
    function isManagerByClaim() {
      return isSignedIn() && request.auth.token.role in ['admin', 'manager'];
    }

    function isPartner() {
      return isSignedIn() && myRole() == 'partner';
    }

    function isActive() {
      return isSignedIn() && myUser().active == true;
    }

    // ------------------------------------------------------------------
    // users: 본인 문서는 읽기 가능, 전체 관리는 admin만
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid
                      && request.resource.data.role == resource.data.role); // 본인 role 변경은 금지
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // schools_detail: 상세정보 — admin/manager는 CRUD 전체, partner는 자신에게 연결된 학교만 읽기
    // ------------------------------------------------------------------
    match /schools_detail/{schoolId} {
      allow read: if isManager() || (isPartner() && resource.data.partnerId == myUser().partnerId);
      allow create, update: if isManager() && isActive();
      allow delete: if isAdmin();

      match /activities/{activityId} {
        allow read: if isManager() || isPartner();
        allow create: if isManager() && isActive();
        allow update, delete: if isAdmin();
      }
      match /quotes/{quoteId} {
        allow read: if isManager();
        allow write: if isManager() && isActive();
      }
      match /files/{fileId} {
        allow read: if isManager() || isPartner();
        allow write: if isManager() && isActive();
      }
      match /ai_logs/{logId} {
        allow read: if isManager();
        allow write: if false; // 서버(API Route, Admin SDK)에서만 기록
      }
    }

    // ------------------------------------------------------------------
    // schools_summary: 목록/지도/칸반/대시보드 집계(count) 전용 경량 사본.
    // count() 집계쿼리는 get()으로 다른 문서를 읽는 규칙과 호환되지 않으므로,
    // 여기서만 예외적으로 커스텀 클레임 기반 isManagerByClaim()을 사용한다.
    // (로그인 계정은 /api/users/sync-claims 로 클레임을 한 번 동기화해둬야 함 — 관리자 설정 화면 참고)
    // ------------------------------------------------------------------
    match /schools_summary/{schoolId} {
      allow read: if isManagerByClaim();
      allow write: if isManager() && isActive();
    }

    // ------------------------------------------------------------------
    // educationOffices
    // ------------------------------------------------------------------
    match /educationOffices/{officeId} {
      allow read: if isManager();
      allow write: if isManager() && isActive();

      match /events/{eventId} {
        allow read: if isManager();
        allow write: if isManager() && isActive();
      }
    }

    // ------------------------------------------------------------------
    // partners: admin/manager 전체 관리. partner 본인 문서는 읽기만 가능
    // ------------------------------------------------------------------
    match /partners/{partnerId} {
      allow read: if isManager() || (isPartner() && myUser().partnerId == partnerId);
      allow create, update, delete: if isManager() && isActive();
    }

    // ------------------------------------------------------------------
    // cases (구축사례): 공개된 자료는 모두 읽기 가능, 쓰기는 manager 이상
    // ------------------------------------------------------------------
    match /cases/{caseId} {
      allow read: if isSignedIn();
      allow write: if isManager() && isActive();
    }

    // ------------------------------------------------------------------
    // contracts: 정산/수수료 데이터는 admin/manager만 전체 조회.
    // partner는 자신이 연결된 계약만 조회 가능
    // ------------------------------------------------------------------
    match /contracts/{contractId} {
      allow read: if isManager() || (isPartner() && resource.data.partnerId == myUser().partnerId);
      allow create, update: if isManager() && isActive();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // schedules
    // ------------------------------------------------------------------
    match /schedules/{scheduleId} {
      allow read: if isManager();
      allow write: if isManager() && isActive();
    }

    // ------------------------------------------------------------------
    // files (전사 공용 파일함)
    // ------------------------------------------------------------------
    match /files/{fileId} {
      allow read: if isSignedIn();
      allow write: if isManager() && isActive();
    }

    // ------------------------------------------------------------------
    // auditLogs: 시스템 기록용, 클라이언트에서는 생성만 허용
    // ------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isManager();
      allow update, delete: if false;
    }
  }
}
